# Copy this file to .env and fill in real values. NEVER commit .env (CLAUDE.md §9).

# --- Datastores (match docker-compose.yml) ---
POSTGRES_DSN=postgresql://algo:algo_dev_pwd@localhost:5432/algotrading
REDIS_URL=redis://localhost:6379/0

# --- Angel One SmartAPI (SOLE execution broker + ticks/OHLC/OI) ---
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- Upstox (PRIMARY Greeks/option-chain, DATA ONLY) ---
UPSTOX_ACCESS_TOKEN=

# --- Trading mode ---
PAPER_TRADING=true

# --- Risk guardrails (Section 5d — NON-NEGOTIABLE defaults) ---
STARTING_CAPITAL=100000     # set to your REAL capital (e.g. 50000) so lot math mirrors reality
RISK_PER_TRADE_PCT=0.02      # regular-day per-trade risk (2%)
EXPIRY_RISK_PCT=0.04         # expiry-day per-trade risk (bigger, for scalping — measure it)
DAILY_LOSS_LIMIT_PCT=0.05    # stop trading for the day at -5% (the real backstop)
MAX_OPEN_POSITIONS=3
MAX_LOTS=5                   # hard ceiling on lots per trade
ROUND_TRIP_COST=50           # brokerage+taxes per round trip (net-P&L modelling)
MIN_NET_PROFIT=100           # don't book a profit smaller than this after costs
